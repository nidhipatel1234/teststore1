{%- comment -%}
  Client Services — CONTACT page (route: /pages/contact_us).
  Uses Shopify's native {% form 'contact' %} (real email delivery — no fake submit).
  Heading/description/subjects/WhatsApp/phones/email/address are section settings.
{%- endcomment -%}

{%- liquid
  assign subjects = section.settings.contact_subjects | newline_to_br | split: '<br />'
-%}

{%- capture cs_panel -%}
  <div class="blk nofilter">
    <h2>{{ section.settings.contact_heading | default: 'Contact Us' | escape }}</h2>
    {%- if section.settings.contact_intro != blank -%}<p>{{ section.settings.contact_intro }}</p>{%- endif -%}
    <div class="cgrid">
      {%- comment -%} id: 'contact_form' → action becomes /contact#contact_form (EN) and /ar/contact#contact_form (AR, Shopify localises the path). {%- endcomment -%}
      {%- form 'contact', id: 'contact_form' -%}
        {%- if form.posted_successfully? -%}
          <p class="fmsg" data-posted="1">Thank you — we reply within 24–48 hours.</p>
        {%- elsif form.errors -%}
          <p class="fmsg err" data-posted="0">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="row2">
          <div class="fld"><label for="cs-nm">Name</label><input id="cs-nm" name="contact[name]" type="text" required {% if customer %}value="{{ customer.name }}"{% endif %}></div>
          <div class="fld"><label for="cs-em">Email</label><input id="cs-em" name="contact[email]" type="email" required {% if customer %}value="{{ customer.email }}"{% endif %}></div>
        </div>
        <div class="row2">
          <div class="fld"><label for="cs-order">Order number</label><input id="cs-order" name="contact[order number]" type="text" required {% if customer %}value="{{ customer.ordernumber }}"{% endif %}></div>
          <div class="fld">
            <label for="cs-reason">What can we help with?</label>
            <select id="cs-reason" name="contact[Reason]">
              <option value="">Select a subject…</option>
              {%- for s in subjects -%}{%- assign st = s | strip -%}{%- if st != blank -%}<option value="{{ st | escape }}">{{ st }}</option>{%- endif -%}{%- endfor -%}
            </select>
          </div>
        </div>
        <div class="fld">
          <label for="cs-country">Country</label>
          <select id="cs-country" name="contact[country]" data-cs-country required>
            <option value="">Select a country…</option>
            {{ country_option_tags | remove: '<option value="---" data-provinces="[]">---</option>' }}
          </select>
          <div class="cs-india-note" style="display:none"><b>Note:</b> We don’t sell in India. Please check <a href="https://minimalist.ae/">minimalist.ae</a>.</div>
        </div>
        <div class="fld"><label for="cs-ms">Message</label><textarea id="cs-ms" name="contact[body]" required></textarea></div>
        <input type="hidden" data-cs-ip name="contact[Ip Address]" value="">
        <button class="btn" type="submit">Send message</button>
      {%- endform -%}

      <aside class="cside">
        <div class="cs-in">
          <div>
            <h4>{{ section.settings.cside_chat_title | default: 'Chat with us' | escape }}</h4>
            <ul>
              <li><a class="wa" href="{{ section.settings.whatsapp_url | default: 'https://api.whatsapp.com/send?phone=971585675555' }}"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.7-5.2A8.5 8.5 0 1 1 21 11.5z"/><path d="M8.6 9.2c.3 2.6 3.6 5.9 6.2 6.2l1-1.4 2 1-1 1.6c-3.6.4-8.6-4.6-8.2-8.2l1.6-1 1 2z"/></svg>{{ section.settings.whatsapp_label | default: 'WhatsApp' }}</a></li>
              {%- if section.settings.whatsapp_number != blank -%}<li><a href="{{ section.settings.whatsapp_url | default: 'https://api.whatsapp.com/send?phone=971585675555' }}">{{ section.settings.whatsapp_number }}</a></li>{%- endif -%}
            </ul>
          </div>
          <div>
            <h4>{{ section.settings.cside_call_title | default: 'Call us' | escape }}</h4>
            <ul>
              {%- if section.settings.phone1 != blank -%}<li><a href="tel:{{ section.settings.phone1 | remove: ' ' }}">{{ section.settings.phone1 }}</a></li>{%- endif -%}
              {%- if section.settings.phone2 != blank -%}<li><a href="tel:{{ section.settings.phone2 | remove: ' ' }}">{{ section.settings.phone2 }}</a></li>{%- endif -%}
            </ul>
          </div>
          <div>
            <h4>{{ section.settings.cside_email_title | default: 'Email' | escape }}</h4>
            {%- if section.settings.email != blank -%}<ul><li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li></ul>{%- endif -%}
          </div>
          <div>
            <h4>{{ section.settings.cside_post_title | default: 'Post' | escape }}</h4>
            <ul><li>{{ section.settings.post_address | default: 'PO Box 83619, Dubai, UAE' | newline_to_br }}</li></ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
{%- endcapture -%}

{{ cs_panel }}


{% schema %}
{
  "name": "Client Svc — Contact",
  "settings": [
    { "type": "paragraph", "content": "Contact page (assign to /pages/contact_us). Uses Shopify’s native contact form — submissions email the store. Sidebar details are below." },
    { "type": "header", "content": "Shared header" },
    { "type": "text", "id": "head_eyebrow", "label": "Eyebrow", "default": "Client Services" },
    { "type": "text", "id": "head_title", "label": "Title", "default": "How can we help?" },
    { "type": "text", "id": "head_subheading", "label": "Subheading", "default": "Shipping, returns, answers and contact — all in one place." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search help articles…" },
    { "type": "text", "id": "track_text", "label": "Track — lead-in text", "default": "Already ordered?" },
    { "type": "text", "id": "track_link_label", "label": "Track — link label", "default": "Track your order" },
    { "type": "url", "id": "track_url", "label": "Track — link URL" },
    { "type": "header", "content": "Contact tab" },
    { "type": "text", "id": "contact_heading", "label": "Heading", "default": "Contact Us" },
    { "type": "text", "id": "contact_intro", "label": "Intro text", "default": "We’re here to answer any question you may have — we reply within 24–48 hours." },
    { "type": "textarea", "id": "contact_subjects", "label": "Form subjects", "info": "One per line — populates the “What can we help with?” dropdown.", "default": "Where’s my order?\nReturns\nCancel or edit order\nPersonalisation\nMarketing & PR\nOther" },
    { "type": "header", "content": "Contact details (sidebar)" },
    { "type": "text", "id": "cside_chat_title", "label": "Chat title", "default": "Chat with us" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp label", "default": "WhatsApp" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "default": "+971 58 567 5555" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp link URL" },
    { "type": "text", "id": "cside_call_title", "label": "Call title", "default": "Call us" },
    { "type": "text", "id": "phone1", "label": "Phone 1", "default": "+971 58 567 5555" },
    { "type": "text", "id": "phone2", "label": "Phone 2", "default": "+971 4 225 2721" },
    { "type": "text", "id": "cside_email_title", "label": "Email title", "default": "Email" },
    { "type": "text", "id": "email", "label": "Email address", "default": "support@minimalist.ae" },
    { "type": "text", "id": "cside_post_title", "label": "Post title", "default": "Post" },
    { "type": "textarea", "id": "post_address", "label": "Postal address", "default": "PO Box 83619,\nDubai, UAE" }
  ],
  "presets": [ { "name": "Client Svc — Contact" } ]
}
{% endschema %}
